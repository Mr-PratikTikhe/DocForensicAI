# Required for Gemini embeddings and generated answers. Without it, the app
# remains usable with local hash-vector retrieval and extractive answers.
GEMINI_API_KEY=

# Optional configuration
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
DJANGO_SECRET_KEY=replace-this-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_ACCESS_PASSWORD=
DATABASE_URL=
# Set automatically when a Vercel private Blob store is connected:
# BLOB_STORE_ID=
# VERCEL_OIDC_TOKEN=
MAX_UPLOAD_SIZE_MB=15
